# Copia este archivo como .env y completa los valores.
# Supabase → Project Settings → API
PORT=3000
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "anon public" (se usa solo para iniciar sesión y registrarse)
SUPABASE_ANON_KEY=
# Clave "service_role" (secreta: nunca en el frontend ni en GitHub)
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: orígenes permitidos por CORS, separados por coma
# CORS_ORIGIN=https://meettennis.vercel.app
