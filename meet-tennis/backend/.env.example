# ==========================================================
# MeetTennis backend — variables de entorno
# Copia este archivo como ".env" y completa los valores.
# ==========================================================

# Puerto del servidor Express (Render lo inyecta automáticamente).
PORT=3000

# Entorno: "development" o "production".
NODE_ENV=development

# --- Supabase -------------------------------------------------
# URL del proyecto (Dashboard → Settings → API).
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública "anon" (se puede exponer; el backend la usa para
# signIn/signUp/refresh).
SUPABASE_ANON_KEY=tu-anon-key

# Clave de servicio "service_role" (NUNCA exponer; solo vive en el
# backend y en las variables de entorno del servidor).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- CORS -----------------------------------------------------
# Orígenes permitidos en producción, separados por coma. Sin esto,
# en producción se deniegan las peticiones cross-origin (las del
# mismo origen, como el proxy de Vercel, no necesitan CORS).
# Ejemplo: https://meettennis.vercel.app
CORS_ORIGIN=

# --- Monitoreo (panel de administración) ----------------------
# Correos de administradores, separados por coma. Se usan como
# respaldo mientras no se ejecute scripts/09_admin_rol.sql en
# Supabase (que agrega la columna "rol" a la tabla usuario).
# Sin esta variable y sin el script 09, NADIE puede ver el panel.
MONITORING_EMAILS=

# --- Google Maps (opcional) -----------------------------------
# API key con la "Geocoding API" habilitada. Solo la usa el script
# scripts/geocodificar_canchas.mjs para obtener las coordenadas
# exactas de cada cancha a partir de su dirección.
GOOGLE_MAPS_API_KEY=
